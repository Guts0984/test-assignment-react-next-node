{
  "name": "api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --watch src/server.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/apps/api/src && cp -r src/data dist/apps/api/src/data",
    "start:dist": "node dist/apps/api/src/server.js",
    "typecheck": "tsc",
    "test": "node --experimental-strip-types --test"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/node": "^22",
    "typescript": "^7.0.2"
  }
}
